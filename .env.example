# Copie para .env.local (dev) ou configure no painel da hospedagem (Vercel/Netlify).
# NUNCA commite valores reais. Todos são lidos apenas no servidor.

# URL pública do site (usada na checagem de Origin/CSRF)
SITE_URL=https://sabrinacoutinho.com.br

# Banco PostgreSQL com TLS obrigatório (sslmode=require) e criptografia em repouso no provedor
DATABASE_URL=postgresql://user:senha@host:5432/sabrina?sslmode=require

# AES-256-GCM: 32 bytes em base64.  Gere com:  openssl rand -base64 32
DATA_ENCRYPTION_KEY=
# HMAC para busca/exclusão por e-mail (LGPD) e assinatura do token CSRF. openssl rand -base64 32
HMAC_SECRET=

# Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis (rate limiting distribuído). Sem isso, cai num limitador em memória (só para dev).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Notificação de novas propostas por e-mail (Resend). Opcional.
RESEND_API_KEY=
CONTACT_INBOX=assessoriaeusabrinasc@gmail.com

# Protege a rota de limpeza automática (LGPD: retenção de 12 meses)
CRON_SECRET=
