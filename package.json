{
  "name": "sabrinaa-coutinho",
  "version": "1.0.0",
  "private": true,
  "description": "Site oficial de Sabrina Coutinho — cupons, parcerias e conteúdo. Next.js + Framer Motion com camada de segurança OWASP/LGPD.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
